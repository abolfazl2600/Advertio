<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_AdvertioCurrentState"
  targetNamespace="https://github.com/abolfazl2600/Advertio/bpmn"
  exporter="OpenAI"
  exporterVersion="1.0">

  <bpmn:process id="Process_AdvertioCurrentState" name="Advertio Current-State Listing Workflow" isExecutable="false">
    <bpmn:documentation>
      Current documented Advertio workflow as of 2026-10-03.
      Discovery uses Search + Active Filters + Saved Filters + Ranking.
      No category-level matching engine is part of this workflow.
      Current verified UI is strongest for Housing; Jobs, Cargo and Human Connections include development specifications.
      Lifecycle monetization timing remains unresolved in source documentation and is represented as configured policy rather than a fixed day.
    </bpmn:documentation>

    <bpmn:laneSet id="LaneSet_Main">
      <bpmn:lane id="Lane_User" name="User / Advertiser">
        <bpmn:flowNodeRef>Task_SelectCategory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterCommonFields</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterCategoryAttributes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PreviewSubmit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SearchFilter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OpenDetail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ContactApply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExtendRenew</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Crawler" name="Telclaw / Crawler">
        <bpmn:flowNodeRef>Task_CollectTelegram</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PreserveRaw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NormalizeExtract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CrawlerValidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IngestAPI</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Platform" name="Advertio Platform">
        <bpmn:flowNodeRef>Start_Source</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Source</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateNative</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SupplyMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetPending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ActivateListing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ActiveFork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IndexDiscovery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordInteraction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reactivate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Interaction</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Admin" name="Admin / Backoffice">
        <bpmn:flowNodeRef>Task_AdminReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Automation" name="Saved Filters / Notifications / Lifecycle">
        <bpmn:flowNodeRef>Task_EvaluateSavedFilters</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FilterSatisfied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Notification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NoAlert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MonitorLifecycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_LifecycleOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Deactivate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Expire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Extend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CategoryTerminal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Deactivated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Expired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_CategoryTerminal</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Source" name="Listing source initiated">
      <bpmn:outgoing>Flow_Start_SourceGateway</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:exclusiveGateway id="Gateway_Source" name="Source type?">
      <bpmn:incoming>Flow_Start_SourceGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Source_Native</bpmn:outgoing>
      <bpmn:outgoing>Flow_Source_Crawler</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_SelectCategory" name="Choose Category">
      <bpmn:incoming>Flow_Source_Native</bpmn:incoming>
      <bpmn:outgoing>Flow_Category_Common</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_EnterCommonFields" name="Enter Common Listing Fields">
      <bpmn:incoming>Flow_Category_Common</bpmn:incoming>
      <bpmn:outgoing>Flow_Common_Attributes</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_EnterCategoryAttributes" name="Enter Category-specific Attributes">
      <bpmn:incoming>Flow_Common_Attributes</bpmn:incoming>
      <bpmn:outgoing>Flow_Attributes_Preview</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_PreviewSubmit" name="Preview &amp; Submit">
      <bpmn:incoming>Flow_Attributes_Preview</bpmn:incoming>
      <bpmn:outgoing>Flow_Preview_ValidateNative</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_ValidateNative" name="Validate Native Listing">
      <bpmn:incoming>Flow_Preview_ValidateNative</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidateNative_Merge</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_CollectTelegram" name="Collect Telegram Post">
      <bpmn:incoming>Flow_Source_Crawler</bpmn:incoming>
      <bpmn:outgoing>Flow_Collect_Raw</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_PreserveRaw" name="Preserve Raw Source + Provenance">
      <bpmn:incoming>Flow_Collect_Raw</bpmn:incoming>
      <bpmn:outgoing>Flow_Raw_Normalize</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_NormalizeExtract" name="Normalize / Classify / Extract">
      <bpmn:incoming>Flow_Raw_Normalize</bpmn:incoming>
      <bpmn:outgoing>Flow_Normalize_CrawlerValidate</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_CrawlerValidate" name="Validate Crawler Record">
      <bpmn:incoming>Flow_Normalize_CrawlerValidate</bpmn:incoming>
      <bpmn:outgoing>Flow_CrawlerValidate_Ingest</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_IngestAPI" name="Advertio Ingest API">
      <bpmn:incoming>Flow_CrawlerValidate_Ingest</bpmn:incoming>
      <bpmn:outgoing>Flow_Ingest_Merge</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_SupplyMerge" name="Supply normalized">
      <bpmn:incoming>Flow_ValidateNative_Merge</bpmn:incoming>
      <bpmn:incoming>Flow_Ingest_Merge</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_Pending</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_SetPending" name="Create / Update Listing as Pending">
      <bpmn:incoming>Flow_Merge_Pending</bpmn:incoming>
      <bpmn:outgoing>Flow_Pending_AdminReview</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_AdminReview" name="Review Listing">
      <bpmn:incoming>Flow_Pending_AdminReview</bpmn:incoming>
      <bpmn:outgoing>Flow_AdminReview_Approved</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_Approved" name="Approved?">
      <bpmn:incoming>Flow_AdminReview_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Approved_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_SetRejected" name="Set Rejected">
      <bpmn:incoming>Flow_Approved_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Rejected_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_Rejected" name="Rejected">
      <bpmn:incoming>Flow_Rejected_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_ActivateListing" name="Publish / Activate Listing">
      <bpmn:incoming>Flow_Approved_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_Reactivate_Activate</bpmn:incoming>
      <bpmn:outgoing>Flow_Activate_Fork</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:parallelGateway id="Gateway_ActiveFork" name="Active Listing">
      <bpmn:incoming>Flow_Activate_Fork</bpmn:incoming>
      <bpmn:outgoing>Flow_Fork_Discovery</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fork_SavedFilters</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fork_Lifecycle</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:serviceTask id="Task_IndexDiscovery" name="Index for Search + Active Filters">
      <bpmn:incoming>Flow_Fork_Discovery</bpmn:incoming>
      <bpmn:outgoing>Flow_Index_Search</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_SearchFilter" name="Search / Apply Active Filters">
      <bpmn:incoming>Flow_Index_Search</bpmn:incoming>
      <bpmn:outgoing>Flow_Search_Detail</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_OpenDetail" name="Open Listing Detail">
      <bpmn:incoming>Flow_Search_Detail</bpmn:incoming>
      <bpmn:outgoing>Flow_Detail_Contact</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ContactApply" name="Official Contact / Apply Action">
      <bpmn:incoming>Flow_Detail_Contact</bpmn:incoming>
      <bpmn:outgoing>Flow_Contact_Analytics</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_RecordInteraction" name="Record Interaction Analytics">
      <bpmn:incoming>Flow_Contact_Analytics</bpmn:incoming>
      <bpmn:outgoing>Flow_Analytics_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_Interaction" name="Interaction recorded">
      <bpmn:incoming>Flow_Analytics_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_EvaluateSavedFilters" name="Evaluate Saved Filters">
      <bpmn:incoming>Flow_Fork_SavedFilters</bpmn:incoming>
      <bpmn:outgoing>Flow_SavedFilters_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_FilterSatisfied" name="Saved Filter satisfied?">
      <bpmn:incoming>Flow_SavedFilters_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Filter_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Filter_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sendTask id="Task_SendNotification" name="Send Notification">
      <bpmn:incoming>Flow_Filter_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Notification_End</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="End_Notification" name="Alert sent">
      <bpmn:incoming>Flow_Notification_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_NoAlert" name="No alert">
      <bpmn:incoming>Flow_Filter_No</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_MonitorLifecycle" name="Monitor Listing Lifecycle">
      <bpmn:incoming>Flow_Fork_Lifecycle</bpmn:incoming>
      <bpmn:outgoing>Flow_Lifecycle_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_LifecycleOutcome" name="Lifecycle outcome">
      <bpmn:incoming>Flow_Lifecycle_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Lifecycle_Deactivate</bpmn:outgoing>
      <bpmn:outgoing>Flow_Lifecycle_Expire</bpmn:outgoing>
      <bpmn:outgoing>Flow_Lifecycle_Terminal</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_Deactivate" name="Deactivate Listing">
      <bpmn:incoming>Flow_Lifecycle_Deactivate</bpmn:incoming>
      <bpmn:outgoing>Flow_Deactivate_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_Deactivated" name="Deactivated">
      <bpmn:incoming>Flow_Deactivate_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_Expire" name="Set Expired">
      <bpmn:incoming>Flow_Lifecycle_Expire</bpmn:incoming>
      <bpmn:outgoing>Flow_Expire_Extend</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_Extend" name="Extend / Renew?">
      <bpmn:incoming>Flow_Expire_Extend</bpmn:incoming>
      <bpmn:outgoing>Flow_Extend_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Extend_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_ExtendRenew" name="Extend / Renew Listing">
      <bpmn:incoming>Flow_Extend_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Extend_Reactivate</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_Reactivate" name="Reactivate Existing Listing">
      <bpmn:incoming>Flow_Extend_Reactivate</bpmn:incoming>
      <bpmn:outgoing>Flow_Reactivate_Activate</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_Expired" name="Expired">
      <bpmn:incoming>Flow_Extend_No</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_CategoryTerminal" name="Set Category-specific Terminal State">
      <bpmn:incoming>Flow_Lifecycle_Terminal</bpmn:incoming>
      <bpmn:outgoing>Flow_Terminal_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_CategoryTerminal" name="Category terminal state">
      <bpmn:incoming>Flow_Terminal_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_SourceGateway" sourceRef="Start_Source" targetRef="Gateway_Source"/>
    <bpmn:sequenceFlow id="Flow_Source_Native" name="Native" sourceRef="Gateway_Source" targetRef="Task_SelectCategory"/>
    <bpmn:sequenceFlow id="Flow_Source_Crawler" name="Crawler" sourceRef="Gateway_Source" targetRef="Task_CollectTelegram"/>
    <bpmn:sequenceFlow id="Flow_Category_Common" sourceRef="Task_SelectCategory" targetRef="Task_EnterCommonFields"/>
    <bpmn:sequenceFlow id="Flow_Common_Attributes" sourceRef="Task_EnterCommonFields" targetRef="Task_EnterCategoryAttributes"/>
    <bpmn:sequenceFlow id="Flow_Attributes_Preview" sourceRef="Task_EnterCategoryAttributes" targetRef="Task_PreviewSubmit"/>
    <bpmn:sequenceFlow id="Flow_Preview_ValidateNative" sourceRef="Task_PreviewSubmit" targetRef="Task_ValidateNative"/>
    <bpmn:sequenceFlow id="Flow_ValidateNative_Merge" sourceRef="Task_ValidateNative" targetRef="Gateway_SupplyMerge"/>
    <bpmn:sequenceFlow id="Flow_Collect_Raw" sourceRef="Task_CollectTelegram" targetRef="Task_PreserveRaw"/>
    <bpmn:sequenceFlow id="Flow_Raw_Normalize" sourceRef="Task_PreserveRaw" targetRef="Task_NormalizeExtract"/>
    <bpmn:sequenceFlow id="Flow_Normalize_CrawlerValidate" sourceRef="Task_NormalizeExtract" targetRef="Task_CrawlerValidate"/>
    <bpmn:sequenceFlow id="Flow_CrawlerValidate_Ingest" sourceRef="Task_CrawlerValidate" targetRef="Task_IngestAPI"/>
    <bpmn:sequenceFlow id="Flow_Ingest_Merge" sourceRef="Task_IngestAPI" targetRef="Gateway_SupplyMerge"/>
    <bpmn:sequenceFlow id="Flow_Merge_Pending" sourceRef="Gateway_SupplyMerge" targetRef="Task_SetPending"/>
    <bpmn:sequenceFlow id="Flow_Pending_AdminReview" sourceRef="Task_SetPending" targetRef="Task_AdminReview"/>
    <bpmn:sequenceFlow id="Flow_AdminReview_Approved" sourceRef="Task_AdminReview" targetRef="Gateway_Approved"/>
    <bpmn:sequenceFlow id="Flow_Approved_Yes" name="Yes" sourceRef="Gateway_Approved" targetRef="Task_ActivateListing"/>
    <bpmn:sequenceFlow id="Flow_Approved_No" name="No" sourceRef="Gateway_Approved" targetRef="Task_SetRejected"/>
    <bpmn:sequenceFlow id="Flow_Rejected_End" sourceRef="Task_SetRejected" targetRef="End_Rejected"/>
    <bpmn:sequenceFlow id="Flow_Activate_Fork" sourceRef="Task_ActivateListing" targetRef="Gateway_ActiveFork"/>
    <bpmn:sequenceFlow id="Flow_Fork_Discovery" sourceRef="Gateway_ActiveFork" targetRef="Task_IndexDiscovery"/>
    <bpmn:sequenceFlow id="Flow_Index_Search" sourceRef="Task_IndexDiscovery" targetRef="Task_SearchFilter"/>
    <bpmn:sequenceFlow id="Flow_Search_Detail" sourceRef="Task_SearchFilter" targetRef="Task_OpenDetail"/>
    <bpmn:sequenceFlow id="Flow_Detail_Contact" sourceRef="Task_OpenDetail" targetRef="Task_ContactApply"/>
    <bpmn:sequenceFlow id="Flow_Contact_Analytics" sourceRef="Task_ContactApply" targetRef="Task_RecordInteraction"/>
    <bpmn:sequenceFlow id="Flow_Analytics_End" sourceRef="Task_RecordInteraction" targetRef="End_Interaction"/>
    <bpmn:sequenceFlow id="Flow_Fork_SavedFilters" sourceRef="Gateway_ActiveFork" targetRef="Task_EvaluateSavedFilters"/>
    <bpmn:sequenceFlow id="Flow_SavedFilters_Gateway" sourceRef="Task_EvaluateSavedFilters" targetRef="Gateway_FilterSatisfied"/>
    <bpmn:sequenceFlow id="Flow_Filter_Yes" name="Yes" sourceRef="Gateway_FilterSatisfied" targetRef="Task_SendNotification"/>
    <bpmn:sequenceFlow id="Flow_Filter_No" name="No" sourceRef="Gateway_FilterSatisfied" targetRef="End_NoAlert"/>
    <bpmn:sequenceFlow id="Flow_Notification_End" sourceRef="Task_SendNotification" targetRef="End_Notification"/>
    <bpmn:sequenceFlow id="Flow_Fork_Lifecycle" sourceRef="Gateway_ActiveFork" targetRef="Task_MonitorLifecycle"/>
    <bpmn:sequenceFlow id="Flow_Lifecycle_Gateway" sourceRef="Task_MonitorLifecycle" targetRef="Gateway_LifecycleOutcome"/>
    <bpmn:sequenceFlow id="Flow_Lifecycle_Deactivate" name="User deactivates" sourceRef="Gateway_LifecycleOutcome" targetRef="Task_Deactivate"/>
    <bpmn:sequenceFlow id="Flow_Lifecycle_Expire" name="Configured expiry" sourceRef="Gateway_LifecycleOutcome" targetRef="Task_Expire"/>
    <bpmn:sequenceFlow id="Flow_Lifecycle_Terminal" name="Category terminal state" sourceRef="Gateway_LifecycleOutcome" targetRef="Task_CategoryTerminal"/>
    <bpmn:sequenceFlow id="Flow_Deactivate_End" sourceRef="Task_Deactivate" targetRef="End_Deactivated"/>
    <bpmn:sequenceFlow id="Flow_Expire_Extend" sourceRef="Task_Expire" targetRef="Gateway_Extend"/>
    <bpmn:sequenceFlow id="Flow_Extend_Yes" name="Yes" sourceRef="Gateway_Extend" targetRef="Task_ExtendRenew"/>
    <bpmn:sequenceFlow id="Flow_Extend_No" name="No" sourceRef="Gateway_Extend" targetRef="End_Expired"/>
    <bpmn:sequenceFlow id="Flow_Extend_Reactivate" sourceRef="Task_ExtendRenew" targetRef="Task_Reactivate"/>
    <bpmn:sequenceFlow id="Flow_Reactivate_Activate" sourceRef="Task_Reactivate" targetRef="Task_ActivateListing"/>
    <bpmn:sequenceFlow id="Flow_Terminal_End" sourceRef="Task_CategoryTerminal" targetRef="End_CategoryTerminal"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_AdvertioCurrentState">
    <bpmndi:BPMNPlane id="BPMNPlane_AdvertioCurrentState" bpmnElement="Process_AdvertioCurrentState">

      <bpmndi:BPMNShape id="Lane_User_di" bpmnElement="Lane_User" isHorizontal="true"><dc:Bounds x="100" y="100" width="3600" height="170"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Crawler_di" bpmnElement="Lane_Crawler" isHorizontal="true"><dc:Bounds x="100" y="270" width="3600" height="170"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Platform_di" bpmnElement="Lane_Platform" isHorizontal="true"><dc:Bounds x="100" y="440" width="3600" height="200"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Admin_di" bpmnElement="Lane_Admin" isHorizontal="true"><dc:Bounds x="100" y="640" width="3600" height="170"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Automation_di" bpmnElement="Lane_Automation" isHorizontal="true"><dc:Bounds x="100" y="810" width="3600" height="220"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_Source_di" bpmnElement="Start_Source"><dc:Bounds x="145" y="512" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Source_di" bpmnElement="Gateway_Source" isMarkerVisible="true"><dc:Bounds x="230" y="505" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SelectCategory_di" bpmnElement="Task_SelectCategory"><dc:Bounds x="350" y="135" width="130" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EnterCommonFields_di" bpmnElement="Task_EnterCommonFields"><dc:Bounds x="525" y="135" width="150" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EnterCategoryAttributes_di" bpmnElement="Task_EnterCategoryAttributes"><dc:Bounds x="720" y="135" width="160" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PreviewSubmit_di" bpmnElement="Task_PreviewSubmit"><dc:Bounds x="925" y="135" width="130" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CollectTelegram_di" bpmnElement="Task_CollectTelegram"><dc:Bounds x="350" y="315" width="130" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PreserveRaw_di" bpmnElement="Task_PreserveRaw"><dc:Bounds x="525" y="315" width="150" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NormalizeExtract_di" bpmnElement="Task_NormalizeExtract"><dc:Bounds x="720" y="315" width="160" height="80"/></bpmndi:BPMNShape>
